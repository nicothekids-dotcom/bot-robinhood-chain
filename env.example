# Token dari @BotFather di Telegram
TELEGRAM_BOT_TOKEN=

# RPC endpoint Robinhood Chain (mis. dari Alchemy). Opsional, tapi wajib untuk rug-check.
ROBINHOOD_RPC_URL=

# Threshold alert perubahan harga 5 menit (dalam persen)
PRICE_CHANGE_ALERT_PCT=20

# Minimum likuiditas (USD) untuk pair baru muncul di /new
NEW_PAIR_MIN_LIQUIDITY_USD=10000

# Interval polling watchlist (detik)
POLL_INTERVAL_SECONDS=180

# Path file database SQLite
DB_PATH=watchlist.db
